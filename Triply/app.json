{
  "expo": {
    "name": "Triply",
    "slug": "Triply",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "triply",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.Triply"
    },
    "web": {
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o app acesse sua câmera para tirar fotos das publicações."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o app acesse suas fotos para escolher imagens das publicações."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}